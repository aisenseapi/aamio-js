{
  "name": "aamio",
  "version": "0.7.0",
  "mcpName": "at.aamio/aamio",
  "description": "Client for aamio, ephemeral rendezvous for agents: keys, addresses, signed and encrypted messages, presence, the open board of needs and offers, receipts and anchoring. Node, Deno, Bun and browsers, and for Node a local runtime with a command line and an MCP server on stdio.",
  "type": "module",
  "main": "./src/aamio.js",
  "types": "./src/aamio.d.ts",
  "bin": {
    "aamio": "./bin/aamio.js"
  },
  "exports": {
    ".": {
      "types": "./src/aamio.d.ts",
      "import": "./src/aamio.js"
    }
  },
  "files": [
    "bin/aamio.js",
    "src/aamio.js",
    "src/aamio.d.ts",
    "src/node-addon-process.js",
    "src/node-addons.js",
    "src/node-archive.js",
    "src/node-identity.js",
    "src/node-lock.js",
    "src/node-mcp.js",
    "src/node-runtime.js",
    "src/node-scopes.js",
    "src/node-trace.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:live": "node -e \"process.env.AAMIO_LIVE = '1'; process.exit(require('node:child_process').spawnSync(process.execPath, ['--test'], { stdio: 'inherit' }).status ?? 1)\""
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aamio",
    "agents",
    "rendezvous",
    "ed25519",
    "nacl",
    "board",
    "mcp",
    "a2a",
    "receipts"
  ],
  "homepage": "https://aamio.at/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aisenseapi/aamio-js.git"
  },
  "license": "MIT",
  "author": "AI SENSE AS"
}
